{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkToLinux",
  "version": "1.0.1",
  "identifier": "dev.linktolinux.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinkToLinux",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Phone Link for Linux and Android",
    "longDescription": "Connect an Android phone to Linux for photos, camera, microphone and clipboard sharing over local Wi-Fi, with optional ADB screen tools.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": [
      "resources/scrcpy-server.jar"
    ]
  }
}
