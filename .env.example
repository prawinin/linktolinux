# Direct Wi-Fi listener. Restart the desktop after changing these values.
LINKTOLINUX_LAN_HOST=0.0.0.0
LINKTOLINUX_LAN_PORT=1718
# Optional overrides for multi-interface/VPN systems and external tools.
# LINKTOLINUX_LAN_IP=
# LINKTOLINUX_ADB=
# LINKTOLINUX_FFMPEG=
# LINKTOLINUX_APK=
# Build worker limit (1..6).
BUILD_JOBS=4
# Android release signing; alternatively use private android-companion/signing/signing.properties.
# LINKTOLINUX_KEYSTORE=
# LINKTOLINUX_KEYSTORE_PASSWORD=
# LINKTOLINUX_KEY_ALIAS=
# LINKTOLINUX_KEY_PASSWORD=
